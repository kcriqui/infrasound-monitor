# systemd unit template for the daily dashboard rebuild (run by infra-dashboard.timer).
# deploy/setup.sh --dashboard substitutes the placeholders and installs it. publish.sh
# rebuilds into <project>/site, which Tailscale Funnel serves (see DEPLOY.md).
[Unit]
Description=INFRA20 dashboard rebuild

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__PROJECT__
ExecStart=/bin/bash deploy/publish.sh
