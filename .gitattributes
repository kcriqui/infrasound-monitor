# Normalize line endings in the repo (LF), with per-type checkout rules so files
# work on their target platform regardless of the contributor's git settings.
* text=auto

# Must be LF -- these run on Linux / Raspberry Pi:
*.sh       text eol=lf
*.service  text eol=lf
*.timer    text eol=lf

# Binaries -- never touch:
*.png  binary
*.npz  binary
*.pdf  binary
*.bin  binary

# Container/deploy files are consumed on Linux (TrueNAS). CRLF breaks Dockerfile
# directives and anything the shell sources, so pin them the same way as *.sh.
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.conf          text eol=lf
.dockerignore   text eol=lf
