# systemd unit template for the daily dashboard rebuild + publish (run by
# infra-dashboard.timer). deploy/setup.sh --dashboard substitutes the placeholders and
# installs it. publish.sh rebuilds into <project>/site and force-pushes if that dir is a
# git clone of a static-host repo (else it just rebuilds locally). Needs network to push.
[Unit]
Description=INFRA20 dashboard rebuild + publish
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__PROJECT__
ExecStart=/bin/bash deploy/publish.sh
